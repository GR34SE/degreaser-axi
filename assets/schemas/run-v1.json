{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "$id": "https://degreaser.dev/schemas/run-v1.json",
  "title": "Degreaser atomic run state v1",
  "type": "object", "additionalProperties": false,
  "required": ["schemaVersion", "id", "repository", "createdAt", "deadline", "status", "owner", "identity", "tasks"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "id": { "type": "string", "pattern": "^r-[0-9]{8}-[0-9]{4}-[a-f0-9]{4}$" },
    "repository": { "type": "string", "pattern": "^/" },
    "createdAt": { "type": "integer", "minimum": 0 },
    "deadline": { "type": "integer", "minimum": 0 },
    "status": { "enum": ["running", "completed", "partial", "failed"] },
    "owner": {
      "anyOf": [
        { "type": "null" },
        { "type": "object", "additionalProperties": false, "required": ["pid", "heartbeat"],
          "properties": { "pid": { "type": "integer", "minimum": 1 }, "heartbeat": { "type": "integer", "minimum": 0 } }
        }
      ]
    },
    "identity": { "type": "string", "pattern": "^[a-f0-9]{64}$" },
    "tasks": {
      "type": "array", "minItems": 1, "maxItems": 16,
      "items": {
        "type": "object", "additionalProperties": false,
        "required": ["assignment", "promptHash", "status", "result", "rejections", "attempts", "limitations", "usage"],
        "properties": {
          "assignment": { "$ref": "input-v1.json#/definitions/assignment" },
          "promptHash": { "type": ["string", "null"], "pattern": "^[a-f0-9]{64}$" },
          "status": { "enum": ["pending", "running", "findings", "no-findings", "not-applicable", "incomplete", "failed", "cancelled"] },
          "result": { "anyOf": [{ "type": "null" }, { "$ref": "result-v1.json" }] },
          "rejections": {
            "type": "array", "items": {
              "type": "object", "additionalProperties": false, "required": ["index", "reason"],
              "properties": { "index": { "type": "integer", "minimum": 1 }, "reason": { "enum": ["path-not-assessed", "side-unavailable", "source-unavailable", "range-out-of-bounds", "quote-mismatch"] } }
            }
          },
          "attempts": {
            "type": "array", "items": {
              "type": "object", "additionalProperties": false,
              "required": ["startedAt", "endedAt", "sessionId", "failure"],
              "properties": {
                "startedAt": { "type": "integer", "minimum": 0 },
                "endedAt": { "type": ["integer", "null"], "minimum": 0 },
                "sessionId": { "type": ["string", "null"] },
                "failure": { "type": ["string", "null"] }
              }
            }
          },
          "limitations": { "type": "array", "items": { "type": "string" } },
          "usage": {
            "anyOf": [
              { "type": "null" },
              { "type": "object", "additionalProperties": { "type": "number", "minimum": 0 } }
            ]
          }
        }
      }
    }
  }
}
