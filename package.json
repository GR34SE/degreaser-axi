{
  "name": "degreaser-axi",
  "version": "1.0.0",
  "private": false,
  "description": "Focused source-only code review for coding agents",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/GR34SE/degreaser-axi.git"
  },
  "homepage": "https://github.com/GR34SE/degreaser-axi#readme",
  "bugs": {
    "url": "https://github.com/GR34SE/degreaser-axi/issues"
  },
  "publishConfig": {
    "access": "public"
  },
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "os": [
    "darwin",
    "linux"
  ],
  "packageManager": "pnpm@12.14.0",
  "bin": {
    "degreaser": "dist/main.js",
    "degreaser-axi": "dist/main.js"
  },
  "files": [
    "dist",
    "docs"
  ],
  "scripts": {
    "test": "pnpm build && node test/run.ts --test-concurrency=2",
    "test:tooling": "node --test --test-concurrency=2 'test/live/**/*.test.ts'",
    "test:eval": "pnpm build && node --test --test-concurrency=2 'test/eval/**/*.test.ts'",
    "eval": "node eval/cli.mjs run",
    "eval:derive": "node eval/cli.mjs derive",
    "eval:gate": "node eval/cli.mjs gate",
    "eval:campaign": "node eval/cli.mjs campaign",
    "typecheck": "tsc --noEmit",
    "lint": "biome ci",
    "format": "biome check --write",
    "build": "node tools/build.ts",
    "skill:generate": "node tools/build.ts --skill-only",
    "skill:check": "node tools/build.ts --check-skill",
    "docs:generate": "node tools/generate-docs.ts",
    "docs:check": "node tools/generate-docs.ts --check",
    "package:check": "pnpm build && node test/package/check.ts",
    "release:notes": "node tools/release/notes.ts",
    "release:prepare": "node tools/release/prepare.ts",
    "qa": "pnpm build && node test/qa/scenario.mjs",
    "check": "pnpm test && pnpm test:tooling && pnpm typecheck && pnpm lint && node test/package/check.ts",
    "test:install": "node test/install/run.ts",
    "test:live": "node test/live/run.ts"
  },
  "dependencies": {
    "@agentclientprotocol/claude-agent-acp": "0.95.0",
    "@agentclientprotocol/codex-acp": "2.5.0",
    "@clack/prompts": "1.8.1",
    "@toon-format/toon": "2.3.1",
    "acpx": "0.21.1",
    "ajv": "8.20.0",
    "axi-sdk-js": "0.1.13",
    "pi-acp": "0.0.33"
  },
  "devDependencies": {
    "@actions/expressions": "0.3.61",
    "@biomejs/biome": "2.6.3",
    "@types/node": "24.19.2",
    "promptfoo": "0.125.1",
    "release-please": "17.3.0",
    "typescript": "7.0.2",
    "yaml": "2.9.1"
  }
}
