{
  "$schema": "https://biomejs.dev/schemas/2.6.3/schema.json",
  "files": {
    "includes": [
      "src/**",
      "tools/**",
      "test/**",
      "eval/**",
      "!!eval/.generated",
      "!!eval/gepa/.venv",
      "!!eval/gepa/__pycache__",
      "*.json",
      "!skills-lock.json",
      "!!**/.claude/worktrees"
    ]
  },
  "formatter": { "indentStyle": "space" },
  "overrides": [
    {
      "includes": [
        "src/**/*.schema.json",
        "src/**/rubric.md",
        "src/review/attempt/prompt/*.md",
        "test/fixtures/skill-baseline.md"
      ],
      "formatter": { "enabled": false }
    }
  ],
  "linter": { "enabled": true, "rules": { "preset": "recommended" } },
  "assist": { "actions": { "source": { "organizeImports": "on" } } }
}
